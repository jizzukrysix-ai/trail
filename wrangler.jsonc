{
  // Local development + deployment config for the Vaultgram Worker.
  // `wrangler dev` bundles worker/index.ts directly (TypeScript, no runtime deps).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaultgram",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vaultgram",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "vaultgram-files"
    }
  ],
  "vars": {
    // Change this before sharing the admin panel. In production set the
    // ADMIN_PASSWORD secret instead of this value.
    "ADMIN_PASSWORD": "admin123"
  },
  "observability": {
    "enabled": true
  }
}
