{
  "name": "vaultgram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vaultgram — a premium Telegram Mini App file vault with Adsgram rewarded unlocks and an admin panel.",
  "scripts": {
    "covers": "node scripts/gen-covers.mjs",
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --ip 127.0.0.1",
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "start": "wrangler dev",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
